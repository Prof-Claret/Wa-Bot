# How the bot links to WhatsApp on first run: "qrcode" (scan) or "code"
# (request a pairing code shown in the terminal — requires PHONE_NUMBER).
PAIRING_MODE=qrcode

# Required only when PAIRING_MODE=code: your WhatsApp number with country
# code, digits only (e.g. 15551234567). No "+", no spaces.
PHONE_NUMBER=

# Command prefix. Commands: !ping !breathe !hydrate ...
WABOT_PREFIX=!

# Owner jid for admin commands (!pause !resume !stats).
# Accepts raw digits (15551234567) or a full jid (...@s.whatsapp.net).
OWNER=

# Group response policy: "mention-or-prefix" (default) or "prefix-only".
GROUP_RESPONSE=mention-or-prefix

# Minimum ms between sends to the same chat (ban-safety pacing).
MIN_SEND_INTERVAL_MS=1200

# pino levels for our logs and Baileys' internal logs.
LOG_LEVEL=info
BAILEYS_LOG_LEVEL=warn

# Where state and auth live (relative to repo root).
DATA_DIR=data
AUTH_DIR=.session
